[Unit]
Description=zoro — Telegram agent (Claude Code) for rafiña
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rafael
Group=rafael
WorkingDirectory=/home/rafael/zoro
EnvironmentFile=/home/rafael/zoro/.env
Environment=PATH=/home/rafael/.local/bin:/home/rafael/.bun/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/rafael/zoro/bin/zoro
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zoro

# Full autonomy: the agent works across /home/rafael and needs ~/.claude creds.
# ProtectHome=false is required to read ~/.claude/.credentials.json + transcripts.
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=false
LockPersonality=true

[Install]
WantedBy=multi-user.target
