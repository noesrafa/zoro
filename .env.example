# Copy to .env and fill in. systemd loads this via EnvironmentFile.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

CLAUDE_BIN=/home/rafael/.local/bin/claude
CLAUDE_MODEL=opus

ZORO_WORK_DIR=/home/rafael
ZORO_PROMPT_FILE=/home/rafael/zoro/prompt/zoro.md
ZORO_STATE_DIR=/home/rafael/zoro/state
ZORO_INBOX_DIR=/home/rafael/zoro/inbox
ZORO_OUTBOX_DIR=/home/rafael/zoro/outbox
ZORO_DANGER_SKIP=true
ZORO_MAX_FILE_BYTES=20971520

FFMPEG_BIN=ffmpeg

# Voice IN (speech-to-text) — whisper.cpp:
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANG=es

# Voice OUT (text-to-speech) — piper:
PIPER_BIN=
PIPER_VOICE=
